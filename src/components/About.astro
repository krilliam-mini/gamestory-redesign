---
const capabilities = [
	"Custom AI Development",
	"Machine Learning Models",
	"Natural Language Processing",
	"Computer Vision Solutions",
	"Reinforcement Learning",
	"Scalable Infrastructure"
];
---

<section id="about" class="about">
	<div class="about-container">
		<div class="about-grid">
			<!-- Left: Visual element -->
			<div class="about-visual">
				<div class="visual-frame">
					<!-- Layered organic shapes -->
					<div class="organic-layers">
						<div class="layer layer-1"></div>
						<div class="layer layer-2"></div>
						<div class="layer layer-3"></div>
					</div>

					<!-- Central element with rotating text -->
					<div class="central-element">
						<div class="rotating-ring">
							<svg viewBox="0 0 200 200">
								<defs>
									<path id="circlePath" d="M 100, 100 m -70, 0 a 70,70 0 1,1 140,0 a 70,70 0 1,1 -140,0"/>
								</defs>
								<text fill="currentColor">
									<textPath href="#circlePath" class="ring-text">
										AI • ML • DL • NLP • CV • RL • AI • ML • DL • NLP • CV • RL •
									</textPath>
								</text>
							</svg>
						</div>
						<div class="core-icon">
							<span>GS</span>
						</div>
					</div>

					<!-- Floating elements -->
					<div class="float-element float-1">AI</div>
					<div class="float-element float-2">ML</div>
					<div class="float-element float-3">NLP</div>
				</div>
			</div>

			<!-- Right: Content -->
			<div class="about-content">
				<span class="section-tag">About Us</span>

				<h2 class="about-title">
					Our USP is
					<span class="highlight-text">All Things AI</span>
				</h2>

				<p class="about-description">
					GameStory builds intelligent, creative, and scalable AI solutions across potentially any field.
					We don't just apply AI — we craft bespoke solutions that push the boundaries of what's possible.
				</p>

				<p class="about-description">
					Our vision is to continuously expand into new domains as we gain sufficient exposure and expertise.
					Every challenge is an opportunity to innovate.
				</p>

				<!-- Capabilities -->
				<div class="capabilities">
					<h4 class="capabilities-title">Our Capabilities</h4>
					<div class="capabilities-grid">
						{capabilities.map((capability, index) => (
							<div class="capability" style={`--index: ${index}`}>
								<span class="capability-marker"></span>
								<span>{capability}</span>
							</div>
						))}
					</div>
				</div>

				<!-- CTA -->
				<a href="/contact" class="about-cta">
					<span>Start a Conversation</span>
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
						<path d="M4 10H16M16 10L10 4M16 10L10 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		padding: 8rem 2rem;
		overflow: hidden;
		background: var(--color-cream);
	}

	.about::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--color-border), transparent);
	}

	.about-container {
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6rem;
		align-items: center;
	}

	/* Visual side */
	.about-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 500px;
	}

	.visual-frame {
		position: relative;
		width: 350px;
		height: 350px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Organic layered shapes */
	.organic-layers {
		position: absolute;
		inset: 0;
	}

	.layer {
		position: absolute;
		border-radius: 50%;
		animation: breathe 8s ease-in-out infinite;
	}

	.layer-1 {
		inset: 0;
		background: radial-gradient(circle, rgba(198, 93, 59, 0.1) 0%, transparent 70%);
		animation-delay: 0s;
	}

	.layer-2 {
		inset: 30px;
		background: radial-gradient(circle, rgba(45, 90, 74, 0.12) 0%, transparent 70%);
		animation-delay: -2.5s;
	}

	.layer-3 {
		inset: 60px;
		background: radial-gradient(circle, rgba(184, 134, 11, 0.1) 0%, transparent 70%);
		animation-delay: -5s;
	}

	@keyframes breathe {
		0%, 100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.05);
			opacity: 0.8;
		}
	}

	/* Central element */
	.central-element {
		position: relative;
		width: 180px;
		height: 180px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.rotating-ring {
		position: absolute;
		inset: 0;
		animation: rotate-slow 30s linear infinite;
	}

	.rotating-ring svg {
		width: 100%;
		height: 100%;
	}

	.ring-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		fill: var(--color-text-muted);
	}

	@keyframes rotate-slow {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.core-icon {
		width: 80px;
		height: 80px;
		background: var(--color-warm-white);
		border: 2px solid var(--color-border);
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--shadow-md);
	}

	.core-icon span {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--color-terracotta);
	}

	/* Floating elements */
	.float-element {
		position: absolute;
		padding: 0.5rem 1rem;
		background: var(--color-warm-white);
		border: 1px solid var(--color-border-light);
		border-radius: 8px;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		box-shadow: var(--shadow-sm);
		animation: float-gentle 6s ease-in-out infinite;
	}

	.float-1 {
		top: 15%;
		right: 5%;
		animation-delay: 0s;
		color: var(--color-terracotta);
	}

	.float-2 {
		bottom: 20%;
		left: 0%;
		animation-delay: -2s;
		color: var(--color-forest);
	}

	.float-3 {
		top: 50%;
		right: -5%;
		animation-delay: -4s;
		color: var(--color-navy);
	}

	/* Content side */
	.about-content {
		position: relative;
	}

	.section-tag {
		display: inline-block;
		padding: 0.5rem 1.25rem;
		background: var(--color-paper);
		border: 1px solid var(--color-border);
		border-radius: 100px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-forest);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin-bottom: 1.5rem;
	}

	.about-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin-bottom: 1.5rem;
		color: var(--color-text-primary);
	}

	.highlight-text {
		color: var(--color-terracotta);
		font-style: italic;
	}

	.about-description {
		font-size: 1.1rem;
		color: var(--color-text-secondary);
		line-height: 1.8;
		margin-bottom: 1.25rem;
	}

	/* Capabilities */
	.capabilities {
		margin: 2.5rem 0;
		padding: 2rem;
		background: var(--color-warm-white);
		border: 1px solid var(--color-border-light);
		border-radius: 16px;
		box-shadow: var(--shadow-sm);
	}

	.capabilities-title {
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
	}

	.capabilities-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.capability {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.95rem;
		color: var(--color-text-secondary);
	}

	.capability-marker {
		width: 8px;
		height: 8px;
		background: var(--color-forest);
		border-radius: 2px;
		flex-shrink: 0;
	}

	/* CTA */
	.about-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 2rem;
		background: transparent;
		border: 2px solid var(--color-forest);
		border-radius: 100px;
		color: var(--color-forest);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.about-cta:hover {
		background: var(--color-forest);
		color: var(--color-warm-white);
		box-shadow: 0 4px 20px rgba(45, 90, 74, 0.25);
	}

	.about-cta svg {
		transition: transform 0.3s ease;
	}

	.about-cta:hover svg {
		transform: translateX(4px);
	}

	@media (max-width: 968px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 4rem;
		}

		.about-visual {
			order: -1;
			min-height: 350px;
		}

		.visual-frame {
			transform: scale(0.85);
		}

		.capabilities-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.about {
			padding: 5rem 1.5rem;
		}

		.about-visual {
			min-height: 300px;
		}

		.visual-frame {
			transform: scale(0.7);
		}

		.float-element {
			display: none;
		}
	}
</style>
