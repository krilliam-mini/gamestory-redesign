---
---

<section class="hero">
	<!-- Organic background shapes -->
	<div class="hero-shapes">
		<div class="shape shape-1"></div>
		<div class="shape shape-2"></div>
		<div class="shape shape-3"></div>
	</div>

	<!-- Decorative botanical elements -->
	<div class="botanical botanical-left">
		<svg viewBox="0 0 100 200" fill="none">
			<path d="M50 200 Q30 150 50 100 Q70 50 50 0" stroke="currentColor" stroke-width="1" fill="none" opacity="0.3"/>
			<circle cx="50" cy="80" r="15" fill="currentColor" opacity="0.1"/>
			<circle cx="35" cy="120" r="10" fill="currentColor" opacity="0.08"/>
			<circle cx="65" cy="140" r="12" fill="currentColor" opacity="0.06"/>
		</svg>
	</div>
	<div class="botanical botanical-right">
		<svg viewBox="0 0 100 200" fill="none">
			<path d="M50 0 Q70 50 50 100 Q30 150 50 200" stroke="currentColor" stroke-width="1" fill="none" opacity="0.3"/>
			<circle cx="50" cy="60" r="18" fill="currentColor" opacity="0.1"/>
			<circle cx="65" cy="100" r="12" fill="currentColor" opacity="0.08"/>
		</svg>
	</div>

	<div class="hero-content">
		<!-- Eyebrow -->
		<div class="eyebrow">
			<span class="eyebrow-line"></span>
			<span class="eyebrow-text">AI-Powered Innovation</span>
			<span class="eyebrow-line"></span>
		</div>

		<!-- Main headline -->
		<h1 class="hero-title">
			<span class="title-line title-line-1">Shaping the</span>
			<span class="title-line title-line-2">
				<span class="highlight">Future</span> of
			</span>
			<span class="title-line title-line-3">
				Play with <span class="highlight-alt">AI</span>
			</span>
		</h1>

		<!-- Description -->
		<p class="hero-description">
			GameStory builds intelligent, creative, and scalable AI solutions across
			potentially any field. We target specific domains like
			<span class="domain-tag">gaming</span>,
			<span class="domain-tag">logistics</span>, and
			<span class="domain-tag">finance</span> —
			expanding as we gain exposure to new industries.
		</p>

		<!-- CTA buttons -->
		<div class="hero-actions">
			<a href="/contact" class="cta-primary">
				<span>Let's Talk</span>
				<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
					<path d="M3 9H15M15 9L9 3M15 9L9 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>
			<a href="#domains" class="cta-secondary">
				<span>Explore Domains</span>
			</a>
		</div>

		<!-- Stats row -->
		<div class="hero-stats">
			<div class="stat">
				<span class="stat-value">3+</span>
				<span class="stat-label">Industries</span>
			</div>
			<div class="stat-divider"></div>
			<div class="stat">
				<span class="stat-value">AI</span>
				<span class="stat-label">First Approach</span>
			</div>
			<div class="stat-divider"></div>
			<div class="stat">
				<span class="stat-value">&infin;</span>
				<span class="stat-label">Possibilities</span>
			</div>
		</div>
	</div>

	<!-- Scroll indicator -->
	<div class="scroll-indicator">
		<span class="scroll-text">Scroll</span>
		<div class="scroll-line"></div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 2rem 4rem;
		overflow: hidden;
		background: linear-gradient(180deg, var(--color-warm-white) 0%, var(--color-cream) 100%);
	}

	/* Organic background shapes */
	.hero-shapes {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.shape {
		position: absolute;
		border-radius: 50%;
		animation: float-gentle 20s ease-in-out infinite;
	}

	.shape-1 {
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, rgba(198, 93, 59, 0.08) 0%, transparent 70%);
		top: -200px;
		right: -100px;
		animation-delay: 0s;
	}

	.shape-2 {
		width: 500px;
		height: 500px;
		background: radial-gradient(circle, rgba(45, 90, 74, 0.06) 0%, transparent 70%);
		bottom: -150px;
		left: -100px;
		animation-delay: -7s;
	}

	.shape-3 {
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, rgba(184, 134, 11, 0.05) 0%, transparent 70%);
		top: 40%;
		left: 20%;
		animation-delay: -14s;
	}

	@keyframes float-gentle {
		0%, 100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(20px, -20px) scale(1.02);
		}
		66% {
			transform: translate(-15px, 15px) scale(0.98);
		}
	}

	/* Botanical decorations */
	.botanical {
		position: absolute;
		width: 100px;
		height: 200px;
		color: var(--color-forest);
		opacity: 0.4;
		animation: sway 8s ease-in-out infinite;
	}

	.botanical-left {
		left: 5%;
		top: 20%;
		animation-delay: 0s;
	}

	.botanical-right {
		right: 5%;
		bottom: 15%;
		animation-delay: -4s;
	}

	@keyframes sway {
		0%, 100% {
			transform: rotate(-2deg);
		}
		50% {
			transform: rotate(2deg);
		}
	}

	/* Content */
	.hero-content {
		position: relative;
		z-index: 10;
		max-width: 850px;
		text-align: center;
	}

	/* Eyebrow */
	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 2rem;
		animation: fade-up 0.8s ease-out;
	}

	.eyebrow-line {
		width: 40px;
		height: 1px;
		background: var(--color-terracotta);
		opacity: 0.5;
	}

	.eyebrow-text {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-terracotta);
		text-transform: uppercase;
		letter-spacing: 0.15em;
	}

	/* Title */
	.hero-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 5.5rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: 2rem;
		color: var(--color-text-primary);
	}

	.title-line {
		display: block;
		animation: fade-up 0.8s ease-out backwards;
	}

	.title-line-1 { animation-delay: 0.1s; }
	.title-line-2 { animation-delay: 0.2s; }
	.title-line-3 { animation-delay: 0.3s; }

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.highlight {
		color: var(--color-terracotta);
		font-style: italic;
		position: relative;
	}

	.highlight::after {
		content: '';
		position: absolute;
		bottom: 0.1em;
		left: 0;
		right: 0;
		height: 0.3em;
		background: rgba(198, 93, 59, 0.15);
		z-index: -1;
		border-radius: 2px;
	}

	.highlight-alt {
		color: var(--color-forest);
		font-weight: 600;
		position: relative;
		display: inline-block;
	}

	.highlight-alt::before {
		content: '';
		position: absolute;
		inset: -4px -8px;
		background: rgba(45, 90, 74, 0.08);
		border-radius: 8px;
		z-index: -1;
	}

	/* Description */
	.hero-description {
		font-size: 1.2rem;
		color: var(--color-text-secondary);
		max-width: 650px;
		margin: 0 auto 2.5rem;
		line-height: 1.8;
		animation: fade-up 0.8s ease-out 0.4s backwards;
	}

	.domain-tag {
		color: var(--color-forest);
		font-weight: 600;
		position: relative;
	}

	.domain-tag::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-forest);
		opacity: 0.3;
		border-radius: 1px;
	}

	/* Actions */
	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 4rem;
		animation: fade-up 0.8s ease-out 0.5s backwards;
	}

	.cta-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.1rem 2.25rem;
		background: var(--color-terracotta);
		color: var(--color-warm-white);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		border-radius: 100px;
		transition: all 0.3s ease;
		box-shadow: 0 4px 20px rgba(198, 93, 59, 0.25);
	}

	.cta-primary:hover {
		background: var(--color-terracotta-dark);
		transform: translateY(-3px);
		box-shadow: 0 8px 30px rgba(198, 93, 59, 0.35);
	}

	.cta-primary svg {
		transition: transform 0.3s ease;
	}

	.cta-primary:hover svg {
		transform: translateX(4px);
	}

	.cta-secondary {
		display: inline-flex;
		align-items: center;
		padding: 1.1rem 2rem;
		background: transparent;
		color: var(--color-text-primary);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		border: 2px solid var(--color-border);
		border-radius: 100px;
		transition: all 0.3s ease;
	}

	.cta-secondary:hover {
		border-color: var(--color-forest);
		background: rgba(45, 90, 74, 0.05);
		color: var(--color-forest);
	}

	/* Stats */
	.hero-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2.5rem;
		animation: fade-up 0.8s ease-out 0.6s backwards;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.stat-value {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.stat-label {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.stat-divider {
		width: 1px;
		height: 40px;
		background: var(--color-border);
	}

	/* Scroll indicator */
	.scroll-indicator {
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		animation: fade-up 0.8s ease-out 0.7s backwards;
	}

	.scroll-text {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-text-muted);
	}

	.scroll-line {
		width: 1px;
		height: 40px;
		background: linear-gradient(to bottom, var(--color-terracotta), transparent);
		animation: scroll-pulse 2s ease-in-out infinite;
	}

	@keyframes scroll-pulse {
		0%, 100% {
			opacity: 1;
			transform: scaleY(1);
		}
		50% {
			opacity: 0.5;
			transform: scaleY(0.7);
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 6rem 1.5rem 3rem;
		}

		.botanical {
			display: none;
		}

		.hero-description {
			font-size: 1.05rem;
		}

		.hero-stats {
			gap: 1.5rem;
		}

		.stat-value {
			font-size: 1.5rem;
		}

		.cta-primary,
		.cta-secondary {
			padding: 0.95rem 1.75rem;
			font-size: 1rem;
		}
	}
</style>
