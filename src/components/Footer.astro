---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-top">
			<!-- Brand -->
			<div class="footer-brand">
				<a href="/" class="footer-logo">
					<span class="logo-icon">◆</span>
					<span class="logo-text">GameStory</span>
				</a>
				<p class="footer-tagline">
					Building intelligent AI solutions across gaming, logistics, and finance.
				</p>
			</div>

			<!-- Links -->
			<div class="footer-links">
				<div class="link-group">
					<h4 class="link-title">Company</h4>
					<a href="/" class="link">Home</a>
					<a href="#domains" class="link">Domains</a>
					<a href="#about" class="link">About</a>
				</div>

				<div class="link-group">
					<h4 class="link-title">Connect</h4>
					<a href="/contact" class="link">Contact Us</a>
					<a href="#" class="link">LinkedIn</a>
					<a href="#" class="link">Twitter</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="copyright">
				© {currentYear} GameStory. All rights reserved.
			</p>

			<div class="footer-accent">
				<span class="accent-text">AI-First</span>
				<span class="accent-dot"></span>
				<span class="accent-text">Future-Ready</span>
			</div>
		</div>
	</div>

	<!-- Decorative top border -->
	<div class="footer-border"></div>
</footer>

<style>
	.footer {
		position: relative;
		background: var(--color-abyss);
		padding: 4rem 2rem 2rem;
	}

	.footer-border {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-neon-cyan) 20%,
			var(--color-neon-magenta) 50%,
			var(--color-neon-cyan) 80%,
			transparent
		);
		opacity: 0.5;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-top {
		display: flex;
		justify-content: space-between;
		gap: 4rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 2rem;
	}

	/* Brand */
	.footer-brand {
		max-width: 300px;
	}

	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--color-text-primary);
		margin-bottom: 1rem;
	}

	.logo-icon {
		font-size: 1.5rem;
		color: var(--color-neon-cyan);
		text-shadow: var(--glow-cyan);
	}

	.logo-text {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.5rem;
		letter-spacing: -0.02em;
	}

	.footer-tagline {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	/* Links */
	.footer-links {
		display: flex;
		gap: 4rem;
	}

	.link-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.link-title {
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-primary);
		margin-bottom: 0.5rem;
	}

	.link {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.link:hover {
		color: var(--color-neon-cyan);
	}

	/* Bottom */
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.copyright {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.footer-accent {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.accent-text {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.accent-dot {
		width: 4px;
		height: 4px;
		background: var(--color-neon-lime);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--color-neon-lime);
	}

	@media (max-width: 768px) {
		.footer {
			padding: 3rem 1.5rem 1.5rem;
		}

		.footer-top {
			flex-direction: column;
			gap: 2rem;
		}

		.footer-brand {
			max-width: none;
		}

		.footer-links {
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
