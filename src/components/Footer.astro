---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-container">
		<!-- Decorative top element -->
		<div class="footer-decoration">
			<div class="decoration-line"></div>
			<div class="decoration-mark">
				<span>GS</span>
			</div>
			<div class="decoration-line"></div>
		</div>

		<div class="footer-top">
			<!-- Brand -->
			<div class="footer-brand">
				<a href="/" class="footer-logo">
					<span class="logo-mark"></span>
					<span class="logo-text">GameStory</span>
				</a>
				<p class="footer-tagline">
					Building intelligent AI solutions across gaming, logistics, and finance.
				</p>
			</div>

			<!-- Links -->
			<div class="footer-links">
				<div class="link-group">
					<h4 class="link-title">Company</h4>
					<a href="/" class="link">Home</a>
					<a href="#domains" class="link">Domains</a>
					<a href="#about" class="link">About</a>
				</div>

				<div class="link-group">
					<h4 class="link-title">Connect</h4>
					<a href="/contact" class="link">Contact Us</a>
					<a href="#" class="link">LinkedIn</a>
					<a href="#" class="link">Twitter</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="copyright">
				&copy; {currentYear} GameStory. All rights reserved.
			</p>

			<div class="footer-accent">
				<span class="accent-text">AI-First</span>
				<span class="accent-dot"></span>
				<span class="accent-text">Future-Ready</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		background: var(--color-warm-white);
		padding: 0 2rem 2rem;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Decorative top element */
	.footer-decoration {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		padding: 3rem 0;
	}

	.decoration-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--color-border), transparent);
		max-width: 200px;
	}

	.decoration-mark {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-paper);
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}

	.decoration-mark span {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-terracotta);
	}

	.footer-top {
		display: flex;
		justify-content: space-between;
		gap: 4rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--color-border-light);
		margin-bottom: 2rem;
	}

	/* Brand */
	.footer-brand {
		max-width: 300px;
	}

	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--color-text-primary);
		margin-bottom: 1rem;
	}

	.logo-mark {
		width: 24px;
		height: 24px;
		background: linear-gradient(135deg, var(--color-terracotta) 0%, var(--color-ochre) 100%);
		border-radius: 6px;
		position: relative;
	}

	.logo-mark::after {
		content: '';
		position: absolute;
		inset: 3px;
		border: 1.5px solid var(--color-warm-white);
		border-radius: 3px;
	}

	.logo-text {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}

	.footer-tagline {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	/* Links */
	.footer-links {
		display: flex;
		gap: 4rem;
	}

	.link-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.link-title {
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text-primary);
		margin-bottom: 0.5rem;
	}

	.link {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.link:hover {
		color: var(--color-terracotta);
	}

	/* Bottom */
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.copyright {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.footer-accent {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.accent-text {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.accent-dot {
		width: 5px;
		height: 5px;
		background: var(--color-forest);
		border-radius: 50%;
	}

	@media (max-width: 768px) {
		.footer {
			padding: 0 1.5rem 1.5rem;
		}

		.footer-decoration {
			padding: 2rem 0;
		}

		.decoration-line {
			max-width: 60px;
		}

		.footer-top {
			flex-direction: column;
			gap: 2rem;
		}

		.footer-brand {
			max-width: none;
		}

		.footer-links {
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
