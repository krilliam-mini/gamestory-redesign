---
const domains = [
	{
		icon: "🎮",
		title: "Gaming",
		description: "Intelligent NPCs, procedural content generation, and adaptive gameplay experiences powered by cutting-edge AI.",
		color: "terracotta",
		features: ["Dynamic Storytelling", "AI NPCs", "Procedural Worlds"]
	},
	{
		icon: "📦",
		title: "Logistics",
		description: "Optimize supply chains, predict demand, and automate operations with machine learning solutions.",
		color: "forest",
		features: ["Route Optimization", "Demand Forecasting", "Warehouse AI"]
	},
	{
		icon: "💰",
		title: "Finance",
		description: "Risk assessment, fraud detection, and algorithmic trading powered by advanced AI models.",
		color: "navy",
		features: ["Risk Analysis", "Fraud Detection", "Trading Algorithms"]
	}
];
---

<section id="domains" class="domains">
	<div class="domains-container">
		<!-- Section header -->
		<div class="section-header">
			<span class="section-tag">What We Do</span>
			<h2 class="section-title">
				AI Solutions Across
				<span class="title-accent">Key Domains</span>
			</h2>
			<p class="section-description">
				We build out products that target specific domains, expanding our expertise as we gain exposure to new industries.
			</p>
		</div>

		<!-- Domain cards -->
		<div class="domains-grid">
			{domains.map((domain, index) => (
				<article class={`domain-card domain-card-${domain.color}`} style={`--delay: ${index * 0.1}s`}>
					<div class="card-accent"></div>

					<div class="card-header">
						<span class="domain-icon">{domain.icon}</span>
						<h3 class="domain-title">{domain.title}</h3>
					</div>

					<p class="domain-description">{domain.description}</p>

					<div class="domain-features">
						{domain.features.map((feature) => (
							<span class="feature-tag">{feature}</span>
						))}
					</div>

					<div class="card-footer">
						<span class="learn-more">
							Learn more
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</span>
					</div>
				</article>
			))}
		</div>

		<!-- Expansion note -->
		<div class="expansion-note">
			<div class="note-decoration">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				</svg>
			</div>
			<p>We continuously expand into new domains as opportunities arise. <strong>Your industry could be next.</strong></p>
		</div>
	</div>
</section>

<style>
	.domains {
		position: relative;
		padding: 8rem 2rem;
		background: var(--color-paper);
	}

	.domains::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--color-border), transparent);
	}

	.domains-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Section header */
	.section-header {
		text-align: center;
		margin-bottom: 5rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.5rem 1.25rem;
		background: var(--color-warm-white);
		border: 1px solid var(--color-border);
		border-radius: 100px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-terracotta);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin-bottom: 1.5rem;
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin-bottom: 1.5rem;
		color: var(--color-text-primary);
	}

	.title-accent {
		display: block;
		color: var(--color-forest);
		font-style: italic;
	}

	.section-description {
		font-size: 1.15rem;
		color: var(--color-text-secondary);
		max-width: 550px;
		margin: 0 auto;
		line-height: 1.7;
	}

	/* Domain cards grid */
	.domains-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}

	.domain-card {
		position: relative;
		padding: 2.5rem;
		background: var(--color-warm-white);
		border: 1px solid var(--color-border-light);
		border-radius: 24px;
		overflow: hidden;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: var(--shadow-sm);
	}

	.domain-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-lg);
	}

	/* Card accent bar */
	.card-accent {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		transition: height 0.3s ease;
	}

	.domain-card:hover .card-accent {
		height: 6px;
	}

	.domain-card-terracotta .card-accent {
		background: linear-gradient(90deg, var(--color-terracotta), var(--color-ochre));
	}

	.domain-card-forest .card-accent {
		background: linear-gradient(90deg, var(--color-forest), var(--color-forest-light));
	}

	.domain-card-navy .card-accent {
		background: linear-gradient(90deg, var(--color-navy), #2d5a8a);
	}

	/* Card content */
	.card-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.domain-icon {
		font-size: 2.5rem;
		line-height: 1;
	}

	.domain-title {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.domain-card-terracotta:hover .domain-title {
		color: var(--color-terracotta);
	}

	.domain-card-forest:hover .domain-title {
		color: var(--color-forest);
	}

	.domain-card-navy:hover .domain-title {
		color: var(--color-navy);
	}

	.domain-description {
		font-size: 1rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	/* Feature tags */
	.domain-features {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.feature-tag {
		padding: 0.4rem 0.9rem;
		background: var(--color-paper);
		border-radius: 100px;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		transition: all 0.3s ease;
	}

	.domain-card-terracotta:hover .feature-tag {
		background: rgba(198, 93, 59, 0.1);
		color: var(--color-terracotta);
	}

	.domain-card-forest:hover .feature-tag {
		background: rgba(45, 90, 74, 0.1);
		color: var(--color-forest);
	}

	.domain-card-navy:hover .feature-tag {
		background: rgba(30, 58, 95, 0.1);
		color: var(--color-navy);
	}

	/* Card footer */
	.card-footer {
		position: relative;
		z-index: 1;
	}

	.learn-more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.learn-more svg {
		transition: transform 0.3s ease;
	}

	.domain-card:hover .learn-more {
		color: var(--color-text-primary);
	}

	.domain-card:hover .learn-more svg {
		transform: translateX(4px);
	}

	.domain-card-terracotta:hover .learn-more {
		color: var(--color-terracotta);
	}

	.domain-card-forest:hover .learn-more {
		color: var(--color-forest);
	}

	.domain-card-navy:hover .learn-more {
		color: var(--color-navy);
	}

	/* Expansion note */
	.expansion-note {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding: 1.75rem 2.5rem;
		background: var(--color-warm-white);
		border: 2px dashed var(--color-border);
		border-radius: 16px;
		text-align: center;
	}

	.note-decoration {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-paper);
		border-radius: 50%;
		color: var(--color-terracotta);
		flex-shrink: 0;
	}

	.expansion-note p {
		color: var(--color-text-secondary);
		font-size: 1rem;
		line-height: 1.6;
	}

	.expansion-note strong {
		color: var(--color-text-primary);
	}

	@media (max-width: 768px) {
		.domains {
			padding: 5rem 1.5rem;
		}

		.domains-grid {
			grid-template-columns: 1fr;
		}

		.domain-card {
			padding: 2rem;
		}

		.expansion-note {
			flex-direction: column;
			padding: 1.5rem;
		}
	}
</style>
