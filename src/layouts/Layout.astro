---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "GameStory - AI Solutions",
	description = "GameStory builds intelligent, creative, and scalable AI solutions across gaming, logistics, and finance."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Fonts: Fraunces for headings (elegant serif), DM Sans for body -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Warm, organic palette */
		--color-cream: #FAF7F2;
		--color-paper: #F5F0E8;
		--color-warm-white: #FFFCF7;
		--color-sand: #E8E0D4;
		--color-clay: #D4C8B8;

		/* Rich accent colors */
		--color-terracotta: #C65D3B;
		--color-terracotta-dark: #A84A2D;
		--color-forest: #2D5A4A;
		--color-forest-light: #3A7460;
		--color-navy: #1E3A5F;
		--color-gold: #B8860B;
		--color-ochre: #CC7722;

		/* Text colors */
		--color-text-primary: #2C2416;
		--color-text-secondary: #5A5247;
		--color-text-muted: #8A8279;

		/* Decorative */
		--color-border: #D4C8B8;
		--color-border-light: #E8E0D4;

		/* Typography */
		--font-display: 'Fraunces', Georgia, serif;
		--font-body: 'DM Sans', system-ui, sans-serif;

		/* Spacing */
		--space-xs: 0.5rem;
		--space-sm: 1rem;
		--space-md: 2rem;
		--space-lg: 4rem;
		--space-xl: 8rem;
		--space-2xl: 12rem;

		/* Shadows - soft and warm */
		--shadow-sm: 0 2px 8px rgba(44, 36, 22, 0.06);
		--shadow-md: 0 4px 20px rgba(44, 36, 22, 0.08);
		--shadow-lg: 0 8px 40px rgba(44, 36, 22, 0.12);
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background: var(--color-cream);
		color: var(--color-text-primary);
		line-height: 1.6;
		overflow-x: hidden;
		min-height: 100vh;
	}

	/* Subtle paper texture overlay */
	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%' height='100%' filter='url(%23noise)'/%3E%3C/svg%3E");
		opacity: 0.03;
		pointer-events: none;
		z-index: 10000;
	}

	/* Selection styling */
	::selection {
		background: var(--color-terracotta);
		color: var(--color-warm-white);
	}

	/* Scrollbar styling */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: var(--color-paper);
	}

	::-webkit-scrollbar-thumb {
		background: var(--color-clay);
		border-radius: 5px;
		border: 2px solid var(--color-paper);
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--color-terracotta);
	}

	/* Smooth animations */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
