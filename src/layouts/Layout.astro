---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "GameStory - AI Solutions",
	description = "GameStory builds intelligent, creative, and scalable AI solutions across gaming, logistics, and finance."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Fonts: Clash Display for headings, Satoshi for body -->
		<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
		<link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Core palette - Deep space with electric accents */
		--color-void: #050508;
		--color-abyss: #0a0a0f;
		--color-surface: #12121a;
		--color-elevated: #1a1a25;
		--color-border: #2a2a3a;

		/* Text */
		--color-text-primary: #f0f0f5;
		--color-text-secondary: #8888a0;
		--color-text-muted: #5a5a70;

		/* Neon accents */
		--color-neon-cyan: #00fff0;
		--color-neon-magenta: #ff00aa;
		--color-neon-lime: #c8ff00;
		--color-neon-orange: #ff6b00;

		/* Glow effects */
		--glow-cyan: 0 0 30px rgba(0, 255, 240, 0.4), 0 0 60px rgba(0, 255, 240, 0.2);
		--glow-magenta: 0 0 30px rgba(255, 0, 170, 0.4), 0 0 60px rgba(255, 0, 170, 0.2);
		--glow-lime: 0 0 30px rgba(200, 255, 0, 0.4), 0 0 60px rgba(200, 255, 0, 0.2);

		/* Typography */
		--font-display: 'Clash Display', sans-serif;
		--font-body: 'Satoshi', sans-serif;

		/* Spacing */
		--space-xs: 0.5rem;
		--space-sm: 1rem;
		--space-md: 2rem;
		--space-lg: 4rem;
		--space-xl: 8rem;
		--space-2xl: 12rem;
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background: var(--color-void);
		color: var(--color-text-primary);
		line-height: 1.6;
		overflow-x: hidden;
		min-height: 100vh;
	}

	/* Selection styling */
	::selection {
		background: var(--color-neon-cyan);
		color: var(--color-void);
	}

	/* Scrollbar styling */
	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: var(--color-abyss);
	}

	::-webkit-scrollbar-thumb {
		background: var(--color-border);
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--color-neon-cyan);
	}

	/* Smooth animations */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
